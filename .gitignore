# 秘密情報（APIキー）。雛形の .env.example だけは載せる
.env
.env.*
!.env.example
.streamlit/secrets.toml

# 資料（share/）と前処理済みの成果物（artifacts/）は、クローンしてすぐ動くように同梱する。
# 前処理をやり直すときにしか使わない埋め込みのキャッシュだけは載せない
artifacts/embed_cache/

# 実行のたびに増えるもの
logs/
jobs/
checkpoints.sqlite*
questions_test*.csv

# Office のロックファイル（資料ではない。前処理の走査でも除外している）
~$*
.~lock.*

# Python の環境とキャッシュ
.venv/
__pycache__/
*.py[cod]

# ツール・OS が作るもの
.playwright-mcp/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
